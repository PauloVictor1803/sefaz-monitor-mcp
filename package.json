  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "sefaz",
    "nfe",
    "nfce",
    "cte",
    "mdfe",
    "agents",
    "llm",
    "claude",
    "cursor",
    "open-source"
  ],
  "author": "Paulo Magalhães",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  }
}
