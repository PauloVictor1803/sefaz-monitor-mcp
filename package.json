{
  "name": "sefaz-monitor-mcp",
  "version": "1.0.0",
  "description": "Servidor MCP (Streamable HTTP / SSE) e API REST para monitoramento em tempo real dos serviços autorizadores da SEFAZ (NF-e, NFC-e, CT-e, MDF-e) para agentes de IA e clientes MCP",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
